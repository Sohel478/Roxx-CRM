# Environment Configuration Template for Custom CRM MVP

# Environment mode
NODE_ENV=development

# Database (Neon Serverless PostgreSQL)
# Pooled connection string (used by Next.js app in serverless functions)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct connection string (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Authentication
AUTH_SECRET="generate-a-secure-random-string-at-least-32-chars-long"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Transactional Email (Optional for Phase 2)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Roxx CRM <notifications@roxx-crm.local>"

# Blob Storage (Vercel Blob / S3)
BLOB_READ_WRITE_TOKEN=""

# Error Monitoring (Sentry)
SENTRY_DSN=""
